generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FileObject {
  id           String   @id @default(cuid())
  originalName String
  fileName     String
  fileKey      String   @unique
  url          String
  mimeType     String
  size         Int
  category     String
  createdAt    DateTime @default(now())
}
